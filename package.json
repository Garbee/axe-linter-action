{
  "name": "@deque/axe-linter-action",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node bin/clean-dist.mjs",
    "build": "rolldown -c",
    "postbuild": "pnpm-licenses generate-disclaimer --prod --output-file dist/licenses.txt",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "prepare": "husky",
    "test": "node --experimental-default-config-file --test src/*.test.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "minimatch": "^10.2.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@quantco/pnpm-licenses": "^2.2.3",
    "@types/node": "^24.10.13",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "rolldown": "1.0.0-rc.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "undici": "^7.16.0"
  }
}
